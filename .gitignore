# Installed dependencies - thousands of files, and "npm install" rebuilds them.
node_modules/

# Assembled by the Pages workflow on every run.
_site/

# Excel/Office lock files. These exist only while a workbook is open and are deleted
# when it closes, so a committed one is always stale.
~$*

# Separate Next.js project that lives in this folder but is not part of the tournament
# manager. Committed here by accident once; kept out deliberately.
webapp/
